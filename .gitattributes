# Normalize line endings to LF everywhere. sprite.svg is generated by
# scripts/build-sprite.mjs, which writes LF; without this, core.autocrlf=true on
# Windows expects CRLF in the working tree and every build leaves the file dirty
# in `git status` while `git diff` reports no change. `text=auto` lets git detect
# and skip binary files.
* text=auto eol=lf
